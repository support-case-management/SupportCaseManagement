<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SupportCaseManagement.Presentation.Views.CreateCustomerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SupportCaseManagement.Presentation.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    
    xmlns:models="using:SupportCaseManagement.Domain.Models"
    Loaded="Page_Loaded"
    IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}"
    >

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <Grid Padding="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--Rubrik och Underrubrik-->
            <StackPanel Margin="0,0,0,10">
                <TextBlock 
                    x:Name="TitleTxt"
                    Text="Lägg till kund"
                    FontSize="32" />

                <TextBlock 
                    x:Name="SubheadingTxt"
                    Text="Registrera en privatperson eller ett företag som kund"
                    FontSize="16" />
            </StackPanel>

            <!--Sätta kundtyp-->
            <StackPanel Grid.Row="1" Margin="0,20">
                <TextBlock 
                    Text="Kundtyp"
                    FontSize="24" />
                
                <ToggleSwitch 
                    OffContent="Privatkund"
                    OnContent="Företagskund"
                    AutomationProperties.Name="Kundtyp"
                    IsOn="{x:Bind ViewModel.IsCompany, Mode=TwoWay}" />

                <TextBlock 
                    Text="Aktivera reglaget om kunden är ett företag"
                    FontSize="16"/>
            </StackPanel>

            <!--Fylla i kontaktuppgifter-->
            <StackPanel Grid.Row="2" Margin="0,20" Spacing="5">
                <TextBlock 
                    Text="Kontaktuppgifter"
                    FontSize="24"/>

                <TextBlock
                    Text="Fyll i kundens kontaktuppgifter, både namn och e-postadress krävs"
                    FontSize="16" />
                
                <TextBox 
                    HorizontalAlignment="Stretch"
                    Margin="0,10,0,2"
                    Header="{x:Bind ViewModel.NameLabel, Mode=OneWay}"
                    PlaceholderText="Ange namn"
                    Text="{x:Bind ViewModel.CustomerName, Mode=TwoWay}" />

                <TextBox 
                    HorizontalAlignment="Stretch"
                    Header="E-postadress"
                    PlaceholderText="Ange e-postadress"
                    Text="{x:Bind ViewModel.EmailAddress, Mode=TwoWay}" />
            </StackPanel>
            
            <!--Error message-->
            <TextBlock 
                Grid.Row="3"
                Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                FontSize="16"
                Foreground="Red" />
            
            <!--Save and Cancel buttons-->
            <StackPanel Orientation="Horizontal" Grid.Row="4" Spacing="10"  Margin="0,20" >
                <Button 
                    Content="Avbryt"
                    Width="150"
                    Command="{x:Bind ViewModel.CancelCommand}"/>

                <Button 
                    Command="{x:Bind ViewModel.SaveCustomerCommand}"
                    Style="{StaticResource AccentButtonStyle}"
                    Width="150">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <SymbolIcon Symbol="Save" />
                        <TextBlock 
                            x:Name="SaveTxt"
                            Text="Spara kund" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
