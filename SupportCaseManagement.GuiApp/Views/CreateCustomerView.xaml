<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SupportCaseManagement.Presentation.Views.CreateCustomerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SupportCaseManagement.Presentation.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    
    xmlns:models="using:SupportCaseManagement.Domain.Models"
    Loaded="Page_Loaded"
    IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}"
    >

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <Grid Padding="20">
            
            <!--Rubrik och Underrubrik-->
            <StackPanel>
                <TextBlock 
                    Text="Lägg till kund"
                    FontSize="32" />

                <TextBlock 
                    Text="Registrera en privat eller företagskund"
                    FontSize="16" />
            </StackPanel>

            <!--Sätta kundtyp-->
            <StackPanel>
                <TextBlock 
                    Text="Kundtyp"
                    FontSize="24" />
                
                <ToggleSwitch 
                    OffContent="Privatkund"
                    OnContent="Företagskund"
                    AutomationProperties.Name="Kundtyp"
                    IsOn="{x:Bind ViewModel.IsCompany, Mode=TwoWay}" />

                <TextBlock 
                    Text="Aktivera reglaget om kunden är en företagskund"/>
            </StackPanel>

            <!--Fylla i kontaktuppgifter-->
            <StackPanel>
                <TextBlock 
                    Text="Kontaktuppgifter"
                    FontSize="24"/>

                <TextBlock
                    Text="Fyll i kontaktuppgifter. Både namn och e-postadress krävs"
                    FontSize="16" />
                
                <TextBox 
                    HorizontalAlignment="Stretch"
                    Header="{x:Bind ViewModel.NameLabel, Mode=OneWay}"
                    PlaceholderText="Ange namn"
                    Text="{x:Bind ViewModel.CustomerName}" />

                <TextBox 
                    HorizontalAlignment="Stretch"
                    Header="E-postadress"
                    PlaceholderText="Ange e-postadress"
                    Text="{x:Bind ViewModel.EmailAddress}" />
            </StackPanel>
            
            <!--Error message-->
            <TextBlock 
                Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                FontSize="16"
                Foreground="Red" />
            
            <!--Save and Cancel buttons-->
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button 
                    Content="Avbryt"
                    Command="{x:Bind ViewModel.CancelCommand}"/>

                <Button 
                    Command="{x:Bind ViewModel.SaveCustomerCommand}"
                    Style="{StaticResource AccentButtonStyle}" >
                    <StackPanel>
                        <SymbolIcon Symbol="Save" />
                        <TextBlock Text="Spara kund" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
