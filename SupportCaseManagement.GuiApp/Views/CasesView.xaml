<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SupportCaseManagement.Presentation.Views.CasesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SupportCaseManagement.Presentation.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    
    xmlns:models="using:SupportCaseManagement.Domain.Models"
    Loaded="Page_Loaded"
    IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}"
    >

    <Grid Padding="30" RowSpacing="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <TextBlock Text="Ärenden" FontSize="32" />
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock 
                Grid.Column="0"
                FontSize="14"
                Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"/>

            <Button
                Grid.Column="1"
                VerticalAlignment="Center"
                Command="{x:Bind ViewModel.OpenCreateSupportTicketCommand}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <SymbolIcon Symbol="Add" />
                    <TextBlock Text="Lägg till ärende" />
                </StackPanel>
            </Button>
        </Grid>
        
        

    </Grid>
</Page>
