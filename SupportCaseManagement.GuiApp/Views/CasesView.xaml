<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SupportCaseManagement.Presentation.Views.CasesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SupportCaseManagement.Presentation.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    
    xmlns:models="using:SupportCaseManagement.Domain.Models"
    Loaded="Page_Loaded"
    IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}"
    >

    <Grid Padding="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock 
                    Text="Ärenden"
                    FontSize="18" />

                <StackPanel Orientation="Horizontal" Spacing="5">
                    <TextBlock 
                        Text="{x:Bind ViewModel.StatusMessage}"/>
                </StackPanel>
            </StackPanel>
        </Grid>
        
    </Grid>
</Page>
