<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SupportCaseManagement.Presentation.Views.CasesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SupportCaseManagement.Presentation.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    
    xmlns:models="using:SupportCaseManagement.Domain.Models"
    Loaded="Page_Loaded"
    IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}"
    >

    <Grid Padding="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--Rubrik-->
        <TextBlock 
            Text="Ärenden" 
            FontSize="32" />

        <!--Statusmeddelande och sökruta-->
        <Grid Grid.Row="1" ColumnSpacing="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock 
                Grid.Column="0"
                FontSize="16"
                VerticalAlignment="Center"
                Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"/>

            <StackPanel Orientation="Horizontal" Grid.Column="1" Spacing="5">
                <SymbolIcon Symbol="Find"/>

                <TextBox 
                    x:Name="SearchTxtb"
                    PlaceholderText="Sök ärende"
                    Width="200"
                    TextChanged="SearchTxtb_TextChanged"/>
            </StackPanel>
        </Grid>

        <!--Ärendelistan-->
        <Border 
            Grid.Row="2"
            BorderBrush="Gray"
            BorderThickness="1"
            CornerRadius="12"
            Margin="0,8">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border
                    BorderBrush="Gray"
                    BorderThickness="1"
                    Padding="0,8"
                    Background="Gray">

                    <Grid ColumnSpacing="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Text="TITEL"
                            Margin="48,0,0,0" />

                        <TextBlock
                            Grid.Column="1"
                            Text="SKAPAD DATUM" />

                        <TextBlock
                            Grid.Column="2"
                            Text="PRIORITET" />

                        <TextBlock
                            Grid.Column="3"
                            Text="STATUS" />

                        <TextBlock
                            Grid.Column="4"
                            Text="KUND" />
                    </Grid>
                </Border>

                <ListView
                    Grid.Row="1"
                    ItemsSource="{x:Bind ViewModel.SupportTickets}"
                    IsItemClickEnabled="True"
                    ItemClick="SupportTicketList_ItemClick">

                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:SupportTicket">
                            <Grid ColumnSpacing="20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border>
                                        <SymbolIcon Symbol="Document" />
                                    </Border>

                                    <TextBlock
                                        Grid.Column="1"
                                        Text="{x:Bind Title}" />
                                </Grid>

                                <TextBlock
                                    Grid.Column="1"
                                    Text="{x:Bind CreatedAt}" />

                                <TextBlock
                                    Grid.Column="2"
                                    Text="{x:Bind SupportTicketPriority}" />

                                <TextBlock
                                    Grid.Column="3"
                                    Text="{x:Bind SupportTicketStatus}" />

                                <TextBlock
                                    Grid.Column="4"
                                    Text="{x:Bind Customer.CustomerName, Mode=OneWay}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <!--Filter och Lägga till ärende knapp-->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock 
                    VerticalAlignment="Center"
                    Text="Filter"
                    FontSize="16"/>

                <ComboBox x:Name="FilterCmb" 
                          SelectionChanged="FilterCmb_SelectionChanged"
                          Width="150">
                    <ComboBoxItem Content="Nytt"/>
                    <ComboBoxItem Content="Pågående"/>
                    <ComboBoxItem Content="Löst"/>
                    <ComboBoxItem Content="Alla Ärenden"/>
                </ComboBox>
            </StackPanel>
            
            <Button
                Grid.Column="1"
                VerticalAlignment="Center"
                Click="OpenCreateTicketDialog_Click">
               <!-- Command="{x:Bind ViewModel.OpenCreateSupportTicketCommand}"> -->
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <SymbolIcon Symbol="Add" />
                    <TextBlock Text="Lägg till ärende" />
                </StackPanel>
            </Button>
        </Grid>

        <!--Totalt antal sparade ärenden-->
        <StackPanel Grid.Row="4" Margin="0,20" Orientation="Horizontal" Spacing="5">
            <TextBlock 
                VerticalAlignment="Center"
                Text="Totalt antal sparade ärenden:"
                FontSize="16" />
            <TextBlock 
                VerticalAlignment="Center"
                Text="{x:Bind ViewModel.TotalNumberOfSupportTickets}"
                FontSize="16"/>
        </StackPanel>
    </Grid>
</Page>