<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SupportCaseManagement.Presentation.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SupportCaseManagement.Presentation.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

	<ScrollViewer HorizontalScrollBarVisibility="Disabled">
		<Grid Padding="28">
			<StackPanel
                MaxWidth="720"
                HorizontalAlignment="Stretch"
                Spacing="24">

				
				<StackPanel Spacing="6">
					<TextBlock
                        Text="Inställningar"
                        Style="{StaticResource TitleTextBlockStyle}" />

					<TextBlock
                        Text="Välj var dina datafiler för kunder och ärenden ska sparas."
                        Style="{StaticResource BodyTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
				</StackPanel>

			
				<Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="24">
					<StackPanel Spacing="24">

				
						<StackPanel Spacing="12">
							<TextBlock
                                Text="Kundfil"
                                Style="{StaticResource SubtitleTextBlockStyle}" />

							<TextBox
                                Header="Fullständig sökväg"
                                PlaceholderText="C:\SupportCaseData\customers.json"
                                Text="{x:Bind ViewModel.CustomerFilePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

							<TextBlock
                                Text="Ange både mapp och filnamn, exempelvis C:\SupportCaseData\customers.json. Om filen inte finns skapas den när du sparar din första kund."
                                Style="{StaticResource BodyTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap" />

							<Button
                                Style="{StaticResource AccentButtonStyle}"
                                Command="{x:Bind ViewModel.SaveCustomerPathCommand}">
								<StackPanel Orientation="Horizontal" Spacing="8">
									<SymbolIcon Symbol="Save" />
									<TextBlock Text="Spara kundfil" />
								</StackPanel>
							</Button>
						</StackPanel>

						<MenuFlyoutSeparator />

					
						<StackPanel Spacing="12">
							<TextBlock
                                Text="Ärendefil"
                                Style="{StaticResource SubtitleTextBlockStyle}" />

							<TextBox
                                Header="Fullständig sökväg"
                                PlaceholderText="C:\SupportCaseData\cases.json"
                                Text="{x:Bind ViewModel.SupportTicketFilePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

							<TextBlock
                                Text="Ange både mapp och filnamn, exempelvis C:\SupportCaseData\cases.json. Om filen inte finns skapas den när du sparar ditt första ärende."
                                Style="{StaticResource BodyTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap" />

							<Button
                                Style="{StaticResource AccentButtonStyle}"
                                Command="{x:Bind ViewModel.SaveSupportTicketPathCommand}">
								<StackPanel Orientation="Horizontal" Spacing="8">
									<SymbolIcon Symbol="Save" />
									<TextBlock Text="Spara ärendefil" />
								</StackPanel>
							</Button>
						</StackPanel>

					</StackPanel>
				</Border>

			
				<TextBlock
                    Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

			</StackPanel>
		</Grid>
	</ScrollViewer>
</Page>