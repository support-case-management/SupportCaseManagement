<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SupportCaseManagement.Presentation.Views.CaseManagerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SupportCaseManagement.Presentation.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel Margin="24" Spacing="12">
        <TextBlock Text="Ärendetalj"/>
        <TextBlock Text="Kund" />
        <TextBlock x:Name="CustomerName" Text="Ingen Kund vald"/>

        <TextBox x:Name="Title" Header="Rubrik"/>

        <TextBox x:Name="DescriptionBox" 
                 Header="Beskrivning"
                 MinHeight="100"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 
                 />

        <ComboBox x:Name="CaseWorkerBox"
                   Header="Ansvarig handläggare"
                  PlaceholderText="Välj en handläggare"
          
                   />
    </StackPanel>
</Page>
