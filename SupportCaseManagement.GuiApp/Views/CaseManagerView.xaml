<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SupportCaseManagement.Presentation.Views.CaseManagerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SupportCaseManagement.Presentation.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">


    <StackPanel Margin="24" Spacing="12">
        <TextBlock Text="Ärendedetalj"/>
        <TextBlock Text="Kund" />
        <TextBlock x:Name="CustomerName" 
                   Text="{x:Bind ViewModel.SelectedTicket.Customer.CustomerName.Value, Mode=OneWay, TargetNullValue='Ingen Kund kopplad'}"/>

        <TextBox x:Name="Title" 
                 Header="Rubrik"
                 Text="{x:Bind ViewModel.SelectedTicket.Title, Mode=OneWay}"
                 />

        <TextBox x:Name="DescriptionBox" 
                 Header="Beskrivning"
                 Text="{x:Bind ViewModel.SelectedTicket.Description, Mode=OneWay}"
                 MinHeight="100"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 
                 
                 />

        <ComboBox x:Name="CaseWorkerBox"
                   Header="Ansvarig handläggare"
                   PlaceholderText="Välj en handläggare"
                   SelectedItem="{x:Bind ViewModel.SelectedTicket.AssignedCaseWorker, Mode=OneWay}"
                   />
        <ComboBox x:Name="PriorityBox" 
                  Header="prioritet"
                  SelectedIndex="{x:Bind ViewModel.PriorityIndex, Mode=OneWay}"
                  >
            <ComboBoxItem Content="Låg"/>
            <ComboBoxItem Content="Normal"/>
            <ComboBoxItem Content="Hög"/>
        </ComboBox>

        <ComboBox x:Name="Status" 
                  Header="status"
                  SelectedIndex="{x:Bind ViewModel.StatusIndex, Mode=OneWay}"
                  >
            <ComboBoxItem Content="Nytt"/>
            <ComboBoxItem Content="Pågående"/>
            <ComboBoxItem Content="Löst"/>
        </ComboBox>

        <TextBox x:Name="CommentSpace"
                 Header="Ny Kommentar"
                 AcceptsReturn="True"
                 MinHeight="80"
                 TextWrapping="Wrap"/>
        <Button Content="Lägg till en kommentar" />
        <TextBlock Text="Tidigare kommentarer" />
        <ListView x:Name="CommentsList" />



    </StackPanel>


</Page>
